<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorCard"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Master Password"
        android:textColor="@color/colorTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="This password is required to change rules, deactivate protection, or uninstall AegisShield. Without it, the app cannot be removed."
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editSetupPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Create Master Password"
        android:inputType="textPassword"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary" />

    <EditText
        android:id="@+id/editSetupConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Confirm Master Password"
        android:inputType="textPassword"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:text="— OR PERMANENT ADDICTION LOCK —"
        android:textColor="@color/colorTextSecondary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnMagicSetupPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#8B5CF6"
        android:text="✨ Magic Lock (Unbreakable Random Key)"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
